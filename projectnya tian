<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TIAN PROJECT</title>
    <style>
        /* --- 1. PENGATURAN DASAR & TEMA WARNA HIJAU NYALA --- */
        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
        }
        
        :root {
            --bg-dark: #0b0f12;
            --bg-card: #141a1f;
            --neon-green: #39ff14; /* Hijau Nyala */
            --text-light: #ffffff;
            --text-gray: #a0aec0;
        }

        body { 
            background-color: var(--bg-dark); 
            color: var(--text-light);
            scroll-behavior: smooth;
        }

        /* --- 2. HEADER & NAVIGASI (TIAN PROJECT) --- */
        header { 
            background: #0f1418; 
            border-bottom: 2px solid var(--neon-green);
            padding: 20px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            position: sticky; 
            top: 0; 
            z-index: 1000;
            box-shadow: 0 0 15px rgba(57, 255, 20, 0.2);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--neon-green);
            text-shadow: 0 0 10px rgba(57, 255, 20, 0.6);
            letter-spacing: 2px;
        }

        nav a {
            color: var(--text-light);
            text-decoration: none;
            margin-left: 20px;
            font-weight: 600;
            transition: 0.3s;
            padding: 8px 16px;
            border-radius: 4px;
        }

        nav a:hover {
            color: var(--bg-dark);
            background-color: var(--neon-green);
            box-shadow: 0 0 10px var(--neon-green);
        }

        .container { 
            max-width: 1200px; 
            margin: 0 auto; 
            padding: 60px 20px; 
        }

        .section-title { 
            font-size: 2.2rem;
            margin-bottom: 30px; 
            color: var(--neon-green); 
            text-transform: uppercase;
            border-left: 5px solid var(--neon-green);
            padding-left: 15px;
            text-shadow: 0 0 5px rgba(57, 255, 20, 0.3);
        }

        /* --- 3. BAGIAN 1: TIAN PROMUY (ALAT & GAME) --- */
        .promuy-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @media (max-width: 768px) {
            .promuy-layout { grid-template-columns: 1fr; }
        }

        .box-category {
            background: var(--bg-card);
            border: 1px solid #232d35;
            border-radius: 12px;
            padding: 30px;
            transition: 0.3s;
        }

        .box-category:hover {
            border-color: var(--neon-green);
            box-shadow: 0 0 15px rgba(57, 255, 20, 0.1);
        }

        .box-category h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Sub-bagian Game (Free & Premium) */
        .game-subsections {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .game-card {
            background: #1c242b;
            padding: 15px;
            border-radius: 8px;
            border-top: 3px solid var(--text-gray);
        }

        .game-card.free { border-top-color: #3498db; }
        .game-card.premium { border-top-color: var(--neon-green); }

        .game-card h4 { margin-bottom: 8px; }
        .game-card p { font-size: 0.9rem; color: var(--text-gray); }

        /* --- 4. BAGIAN 2: ECOMERS --- */
        .ecomers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #232d35;
            transition: transform 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: var(--neon-green);
        }

        .product-img {
            background: #232d35;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--text-gray);
        }

        .product-info { padding: 20px; }
        .product-price { 
            color: var(--neon-green); 
            font-weight: bold; 
            font-size: 1.2rem; 
            margin-top: 10px; 
            display: block;
        }

        /* --- 5. BAGIAN 3: MEMBERSHIPSHAP --- */
        .member-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .member-card {
            background: var(--bg-card);
            border: 1px solid #232d35;
            border-radius: 12px;
            padding: 40px 30px;
            text-align: center;
            position: relative;
        }

        .member-card.active {
            border: 2px solid var(--neon-green);
            box-shadow: 0 0 20px rgba(57, 255, 20, 0.2);
        }

        .time-badge {
            background: var(--neon-green);
            color: var(--bg-dark);
            padding: 5px 15px;
            font-weight: bold;
            border-radius: 20px;
            font-size: 0.85rem;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 15px;
        }

        .price-tag {
            font-size: 2rem;
            font-weight: 800;
            margin: 20px 0;
            color: #fff;
        }

        .price-tag span { font-size: 1rem; color: var(--text-gray); }

        .btn-buy {
            background: transparent;
            border: 2px solid var(--neon-green);
            color: var(--neon-green);
            padding: 12px 25px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: 0.3s;
        }

        .btn-buy:hover {
            background: var(--neon-green);
            color: var(--bg-dark);
            box-shadow: 0 0 15px var(--neon-green);
        }

        /* --- 6. FOOTER --- */
        footer {
            background: #0f1418;
            text-align: center;
            padding: 30px;
            margin-top: 80px;
            border-top: 1px solid #232d35;
            color: var(--text-gray);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- NAMA TEMA DI ATAS -->
    <header>
        <div class="logo">TIAN PROJECT</div>
        <nav>
            <a href="#tian-promuy">Tian Promuy</a>
            <a href="#ecomers">Ecomers</a>
            <a href="#membership">Membership</a>
        </nav>
    </header>

    <!-- BAGIAN 1: TIAN PROMUY -->
    <section class="container" id="tian-promuy">
        <h2 class="section-title">1. Tian Promuy</h2>
        <div class="promuy-layout">
            
            <!-- Sub-Bagian: ALAT -->
            <div class="box-category">
                <h3>🛠️ Kategori Alat</h3>
                <p style="color: var(--text-gray); margin-bottom: 15px;">Daftar perkakas digital, script, atau tools utilitas untuk membantu produktivitas Anda.</p>
                <ul>
                    <li style="margin: 10px 0; list-style-position: inside;">Automasi Sistem Pro</li>
                    <li style="margin: 10px 0; list-style-position: inside;">Pengoptimal Jaringan</li>
                </ul>
            </div>

            <!-- Sub-Bagian: GAME -->
            <div class="box-category">
                <h3>🎮 Kategori Game</h3>
                <p style="color: var(--text-gray);">Pilih tipe permainan yang ingin Anda jelajahi di bawah ini:</p>
                
                <div class="game-subsections">
                    <!-- 1. GAME FREE -->
                    <div class="game-card free">
                        <h4>🎁 1. GAME FREE</h4>
                        <p>Akses gratis selamanya tanpa biaya tambahan apa pun.</p>
                    </div>
                    <!-- 2. GAME PREMIUM -->
                    <div class="game-card premium">
                        <h4>💎 2. GAME PREMIUM</h4>
                        <p>Game eksklusif dengan fitur modifikasi lengkap & grafik terbaik.</p>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- BAGIAN 2: ECOMERS -->
    <section class="container" id="ecomers">
        <h2 class="section-title">2. Ecomers</h2>
        <div class="ecomers-grid">
            
            <!-- Contoh Barang 1 -->
            <div class="product-card">
                <div class="product-img">[ Foto Barang 1 ]</div>
                <div class="product-info">
                    <h3>Item Keren Pilihan</h3>
                    <p style="color: var(--text-gray); font-size: 0.9rem; margin-top: 5px;">Deskripsi singkat barang yang ingin Anda jual.</p>
                    <span class="product-price">Rp 150.000</span>
                </div>
            </div>

            <!-- Contoh Barang 2 -->
            <div class="product-card">
                <div class="product-img">[ Foto Barang 2 ]</div>
                <div class="product-info">
                    <h3>Item Premium Eksklusif</h3>
                    <p style="color: var(--text-gray); font-size: 0.9rem; margin-top: 5px;">Barang impian kualitas terbaik di toko Anda.</p>
                    <span class="product-price">Rp 350.000</span>
                </div>
            </div>

        </div>
    </section>

